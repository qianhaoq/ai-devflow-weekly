---
layout: null
permalink: /feed.xml
---
{%- comment -%}
Custom Atom feed over the `weekly` collection (newest issue first).
jekyll-feed only covers _posts and skips generating when this file exists,
so /feed.xml stays the feed URL. Collection docs have no front-matter date,
so `updated` is the build time.
{%- endcomment -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | default: 'zh-CN' }}">
  <title type="html">{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" />
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  {%- assign weeks = site.weekly | sort: 'name' | reverse %}
  {%- for week in weeks limit: 20 %}
  <entry>
    <title type="html">{{ week.title | xml_escape }}</title>
    <link href="{{ week.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ week.url | absolute_url }}</id>
    <updated>{{ site.time | date_to_xmlschema }}</updated>
    <content type="html" xml:base="{{ week.url | absolute_url }}">{{ week.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
